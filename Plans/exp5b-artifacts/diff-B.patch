+import XCTest
+import MLX
+import MLXRandom
+import DiffusionCore
+@testable import DiffusionModel
+@testable import DiffusionGeneration
+
+/// exp-5b: cross-turn ``SessionPrefixCache`` — exactness against the session-less cached path,
+/// reuse accounting, divergence/truncation, incompatibility, quantized KV storage, reset.
+///
+/// Fixtures: the M5 toy loop fixtures (`Tools/generate_loop_fixtures.py`; FP32, block 16, 2 layers,
+/// vocab 1000). "Turn N+1" prompts are built as turn N's `finalSequence` plus a short continuation,
+/// which is exactly the multi-turn chat shape (prompt + answer resent, then a new user message).
+final class SessionPrefixCacheTests: XCTestCase {
+
+    typealias Manifest = DenoisingLoopParityTests.Manifest
+    typealias Traces = DenoisingLoopParityTests.Traces
+    typealias Case = DenoisingLoopParityTests.Case
+
+    var manifest: Manifest!
+    var traces: Traces!
+    var model: LLaDA2MoeModel!
+    var B: Int { manifest.blockLength }
+
+    override func setUpWithError() throws {
+        let dir = DenoisingLoopParityTests.fixtureDir
+        let weightsURL = dir.appendingPathComponent("weights.safetensors")
+        let tracesURL = dir.appendingPathComponent("traces.json")
+        let manifestURL = dir.appendingPathComponent("manifest.json")
+        try XCTSkipUnless(
+            FileManager.default.fileExists(atPath: tracesURL.path),
+            "Loop fixtures missing at \(dir.path) — run: python3 Tools/generate_loop_fixtures.py")
+        manifest = try JSONDecoder().decode(Manifest.self, from: Data(contentsOf: manifestURL))
+        traces = try JSONDecoder().decode(Traces.self, from: Data(contentsOf: tracesURL))
+        let dm = DiffusionModel(config: manifest.config)
+        try dm.loadWeights(from: weightsURL)
+        model = dm.model
+    }
+
+    // MARK: helpers
+
+    private func fixtureCase(_ name: String) throws -> Case {
+        guard let c = traces.cases.first(where: { $0.name == name }) else {
+            throw XCTSkip("fixture case \(name) missing")
+        }
+        return c
+    }
+
+    /// A short "next user message": plain low ids, never mask/eos.
+    private func continuation(_ n: Int, seed: Int = 0) -> [Int] {
+        (0 ..< n).map { 3 + (($0 * 7 + seed * 13) % 40) }
+    }
+
+    /// Run `prompt` once fresh (no session) and once through `session`; assert identical
+    /// `finalSequence`/`tokens`, and that the session echo equals `expectedReused`. Returns the
+    /// session output.
+    @discardableResult
+    private func assertTurn(
+        _ label: String, prompt: [Int], params: GenerationParams, K: Int,
+        session: SessionPrefixCache, expectedReused: Int,
+        file: StaticString = #filePath, line: UInt = #line
+    ) -> DiffusionEngine.Output {
+        let engine = DiffusionEngine(model: model, speculationK: K)
+        let fresh = engine.generateCached(prompt: prompt, params: params)
+        let withSession = engine.generateCached(prompt: prompt, params: params, session: session)
+        XCTAssertEqual(withSession.finalSequence, fresh.finalSequence,
+                       "\(label) (K=\(K)): session output differs from session-less output "
+                       + "(first diff \(firstDiff(withSession.finalSequence, fresh.finalSequence)))",
+                       file: file, line: line)
+        XCTAssertEqual(withSession.tokens, fresh.tokens, "\(label): tokens differ", file: file, line: line)
+        XCTAssertEqual(withSession.metrics.sessionReusedTokens, expectedReused,
+                       "\(label): sessionReusedTokens echo", file: file, line: line)
+        XCTAssertEqual(fresh.metrics.sessionReusedTokens, 0, "\(label): no-session call must echo 0",
+                       file: file, line: line)
+        // Effective echo cross-check: each reused block is exactly one prefill forward not run.
+        XCTAssertEqual(fresh.metrics.forwardsEvaluated - withSession.metrics.forwardsEvaluated,
+                       expectedReused / params.blockLength,
+                       "\(label): forwards saved must equal reused blocks", file: file, line: line)
+        // After the call the session holds exactly this call's committed blocks.
+        XCTAssertEqual(session.cachedTokenCount, withSession.finalSequence.count,
+                       "\(label): session must hold the call's committed tokens", file: file, line: line)
+        XCTAssertEqual(session.committedTokens, withSession.finalSequence, file: file, line: line)
+        return withSession
+    }
+
+    /// Exact (bitwise) array equality — the storage tests claim identity, not closeness.
+    private func same(_ a: MLXArray, _ b: MLXArray) -> Bool {
+        a.shape == b.shape && (a .== b).all().item(Bool.self)
+    }
+
+    private func firstDiff(_ a: [Int], _ b: [Int]) -> String {
+        let n = min(a.count, b.count)
+        for i in 0 ..< n where a[i] != b[i] { return "idx \(i): \(a[i]) != \(b[i])" }
+        return a.count == b.count ? "none" : "length \(a.count) != \(b.count)"
+    }
+
+    // MARK: - Multi-turn exactness (K = 1 and K = 4)
+
+    /// Three chat turns: each turn resends the previous turn's prompt + answer plus a new
+    /// message. Turn 2 must reuse every block of turn 1; turn 3 must reuse turn 2's answer.
+    func testMultiTurnExactnessAndReuse() throws {
+        for K in [1, 4] {
+            for name in ["p16_q_noeos", "p8_s_noeos", "p33_q_eos"] {
+                let c = try fixtureCase(name)
+                let p = c.params.toGenerationParams()
+                let session = SessionPrefixCache()
+
+                // Turn 1: empty session, nothing to reuse.
+                let t1 = assertTurn("\(name) turn1", prompt: c.prompt, params: p, K: K,
+                                    session: session, expectedReused: 0)
+                XCTAssertEqual(t1.finalSequence.count % B, 0)
+
+                // Turn 2: prompt = turn-1 committed sequence + continuation. Every full block of
+                // the new prompt is a committed block of turn 1 → all of them reused.
+                let prompt2 = t1.finalSequence + continuation(9)
+                let expected2 = (prompt2.count / B) * B
+                XCTAssertEqual(expected2, t1.finalSequence.count,
+                               "continuation must not complete a new block for this test shape")
+                let t2 = assertTurn("\(name) turn2", prompt: prompt2, params: p, K: K,
+                                    session: session, expectedReused: expected2)
+                XCTAssertGreaterThan(t2.finalSequence.count, t1.finalSequence.count)
+
+                // Turn 3: reuse turn 2's answer blocks as well.
+                let prompt3 = t2.finalSequence + continuation(5, seed: 1)
+                assertTurn("\(name) turn3", prompt: prompt3, params: p, K: K,
+                           session: session, expectedReused: (prompt3.count / B) * B)
+            }
+        }
+    }
+
+    /// A continuation that itself completes a full block: the reused run stops at the session's
+    /// committed length; the new full block is prefilled normally.
+    func testContinuationBeyondSessionIsPrefilled() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+        let prompt2 = t1.finalSequence + continuation(B + 3)   // one new full block + a tail
+        XCTAssertEqual(prompt2.count / B, t1.finalSequence.count / B + 1)
+        assertTurn("turn2", prompt: prompt2, params: p, K: 4, session: session,
+                   expectedReused: t1.finalSequence.count)
+    }
+
+    // MARK: - Partial / diverged prefixes
+
+    /// Turn 2 edits one token inside block 2 of turn 1's sequence: only blocks 0–1 are reused,
+    /// the diverged tail is truncated from the session and recomputed.
+    func testDivergedPrefixReusesOnlyLeadingBlocks() throws {
+        for K in [1, 4] {
+            let c = try fixtureCase("p16_s_noeos")
+            let p = c.params.toGenerationParams()
+            let session = SessionPrefixCache()
+            let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: K, session: session, expectedReused: 0)
+            try XCTSkipUnless(t1.finalSequence.count >= 3 * B, "need ≥3 committed blocks")
+
+            var prompt2 = t1.finalSequence
+            let editIdx = 2 * B + 3
+            prompt2[editIdx] = (prompt2[editIdx] + 1) % 900   // never mask/eos (≥ 900 excluded)
+            prompt2 += continuation(4)
+            assertTurn("diverged", prompt: prompt2, params: p, K: K, session: session, expectedReused: 2 * B)
+        }
+    }
+
+    /// Divergence in the very first block → nothing reusable, session rebuilt from scratch.
+    func testDivergenceInFirstBlockReusesNothing() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+        var prompt2 = t1.finalSequence
+        prompt2[1] = (prompt2[1] + 1) % 900
+        assertTurn("first-block-diverged", prompt: prompt2 + continuation(2), params: p, K: 4,
+                   session: session, expectedReused: 0)
+    }
+
+    /// A shorter prompt than the session holds (the client dropped history): reuse is capped at
+    /// the new prompt's full blocks, and the session is truncated to this call's commits.
+    func testShorterPromptCapsReuseAtPromptFullBlocks() throws {
+        let c = try fixtureCase("p8_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 1, session: session, expectedReused: 0)
+        try XCTSkipUnless(t1.finalSequence.count >= 2 * B + 4)
+        let prompt2 = Array(t1.finalSequence[0 ..< (B + 4)])   // 1 full block + 4-token tail
+        assertTurn("shorter", prompt: prompt2, params: p, K: 1, session: session, expectedReused: B)
+    }
+
+    /// Prompt shorter than one block: nothing to prefill, nothing to reuse, session still updated.
+    func testSubBlockPromptReusesNothing() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        assertTurn("turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+        let tiny = Array(c.prompt.prefix(B - 1))
+        assertTurn("tiny", prompt: tiny, params: p, K: 4, session: session, expectedReused: 0)
+    }
+
+    // MARK: - Incompatible configurations
+
+    /// Changing the storage key (KV quantization / block length / pool) between turns resets the
+    /// session: zero reuse, correct output, session re-keyed to the new call.
+    func testIncompatibleKeyResetsSession() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let base = c.params.toGenerationParams()
+        let variants: [(String, (inout GenerationParams) -> Void)] = [
+            ("kvQuantization", { $0.kvQuantization = .fp4g32 }),   // g32: the toy head_dim-32 model's only runnable mode
+            ("kvPool", { $0.kvPoolEnabled = true }),
+            ("blockLength", { $0.blockLength = 8 }),
+        ]
+        for (name, apply) in variants {
+            let session = SessionPrefixCache()
+            let t1 = assertTurn("\(name) turn1", prompt: c.prompt, params: base, K: 4,
+                                session: session, expectedReused: 0)
+            var p2 = base
+            apply(&p2)
+            let prompt2 = t1.finalSequence + continuation(3)
+            let t2 = assertTurn("\(name) turn2", prompt: prompt2, params: p2, K: 4,
+                                session: session, expectedReused: 0)
+            XCTAssertEqual(session.incompatibleResets, 1, name)
+            XCTAssertEqual(session.key?.blockLength, p2.blockLength, name)
+            XCTAssertEqual(session.key?.kvQuantization, p2.kvQuantization, name)
+            // And the re-keyed session is usable by a third turn under the new config.
+            assertTurn("\(name) turn3", prompt: t2.finalSequence + continuation(2), params: p2, K: 4,
+                       session: session, expectedReused: (t2.finalSequence.count / p2.blockLength) * p2.blockLength)
+        }
+    }
+
+    /// A different model instance (same weights) must not share a session.
+    func testDifferentModelInstanceResetsSession() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+
+        let dm2 = DiffusionModel(config: manifest.config)
+        try dm2.loadWeights(from: DenoisingLoopParityTests.fixtureDir.appendingPathComponent("weights.safetensors"))
+        let other = DiffusionEngine(model: dm2.model, speculationK: 4)
+        let prompt2 = t1.finalSequence + continuation(3)
+        let out = other.generateCached(prompt: prompt2, params: p, session: session)
+        XCTAssertEqual(out.metrics.sessionReusedTokens, 0)
+        XCTAssertEqual(session.incompatibleResets, 1)
+        XCTAssertEqual(session.key?.modelID, ObjectIdentifier(dm2.model))
+    }
+
+    /// Ineligible feature sets bypass the session: no reuse, session left untouched.
+    func testIneligibleParamsBypassSession() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 1, session: session, expectedReused: 0)
+        let heldBefore = session.committedTokens
+
+        var pNBuf = p
+        pNBuf.nBuf = 2
+        pNBuf.tauAdd = 0.1
+        XCTAssertFalse(pNBuf.sessionReuseEligible)
+        let prompt2 = t1.finalSequence + continuation(3)
+        let engine = DiffusionEngine(model: model, speculationK: 1)
+        let bypassed = engine.generateCached(prompt: prompt2, params: pNBuf, session: session)
+        XCTAssertEqual(bypassed.metrics.sessionReusedTokens, 0)
+        XCTAssertEqual(session.committedTokens, heldBefore, "bypassed call must not touch the session")
+
+        // ICE template (per-call argument, not a param) also bypasses. The template here is
+        // exactly the block the loop would build anyway (prompt tail + masks), so the run is
+        // the plain run and its output can be checked too.
+        let firstGenBlock = prompt2.count / B
+        let template = (0 ..< B).map { i -> Int in
+            let g = firstGenBlock * B + i
+            return g < prompt2.count ? prompt2[g] : p.maskId
+        }
+        let fresh = engine.generateCached(prompt: prompt2, params: p)
+        let iced = engine.generateCached(prompt: prompt2, params: p, iceTemplate: template, session: session)
+        XCTAssertEqual(iced.metrics.sessionReusedTokens, 0)
+        XCTAssertEqual(iced.finalSequence, fresh.finalSequence)
+        XCTAssertEqual(session.committedTokens, heldBefore)
+
+        // The untouched session is still fully reusable afterwards.
+        assertTurn("after-bypass", prompt: prompt2, params: p, K: 1, session: session,
+                   expectedReused: t1.finalSequence.count)
+    }
+
+    /// The eligibility allowlist itself.
+    func testSessionReuseEligibilityAllowlist() throws {
+        let base = traces.cases[0].params.toGenerationParams()
+        XCTAssertTrue(base.sessionReuseEligible)
+        var k8 = base; k8.kvQuantization = .k8v4
+        XCTAssertTrue(k8.sessionReuseEligible, "storage mode is a key, not an eligibility exclusion")
+        let disablers: [(String, (inout GenerationParams) -> Void)] = [
+            ("nBuf2", { $0.nBuf = 2 }),
+            ("subBlockCommit", { $0.subBlockCommit = true }),
+            ("flashBlock", { $0.flashBlockEnabled = true }),
+            ("dualCaching", { $0.dualCachingEnabled = true }),
+            ("elastic", { $0.elasticCacheEnabled = true }),
+            ("ice", { $0.iceEnabled = true }),
+            ("ablation", { $0.moduleAblation = .lmHead }),
+        ]
+        for (name, apply) in disablers {
+            var p = base
+            apply(&p)
+            XCTAssertFalse(p.sessionReuseEligible, "\(name) must bypass the session")
+        }
+    }
+
+    // MARK: - Quantized KV storage (k8v4, kivi4) and the pool
+
+    /// Session reuse under compressed storage: output identical to the session-less run under
+    /// the SAME quantization (quantized KV legitimately differs from FP storage — that is not
+    /// what is tested here), through a diverged turn that exercises compressed truncation.
+    ///
+    /// Toy-shape constraint: the fixtures' `head_dim` is 32, and MLX refuses group-64 quantization
+    /// on a 32-wide last axis (`[quantize] The last dimension … divisible by … 64`), so `k8v4` /
+    /// `kivi4` (values g64) cannot run end-to-end here — `fp4g32` (K and V g32) is the only mode the
+    /// toy model admits. `k8v4` and `kivi4` storage/truncation are covered at head_dim 128 in
+    /// `testCompressedTruncationMatchesFreshCompression` / `testLayerKVCacheTruncateAllStorageForms`.
+    func testQuantizedKVSessionExactness() throws {
+        for quant in [KVCacheQuantization.fp4g32] {
+            for K in [1, 4] {
+                let c = try fixtureCase("p16_q_noeos")
+                var p = c.params.toGenerationParams()
+                p.kvQuantization = quant
+                let session = SessionPrefixCache()
+                let t1 = assertTurn("\(quant) turn1", prompt: c.prompt, params: p, K: K,
+                                    session: session, expectedReused: 0)
+                let t2 = assertTurn("\(quant) turn2", prompt: t1.finalSequence + continuation(5), params: p, K: K,
+                                    session: session, expectedReused: t1.finalSequence.count)
+                try XCTSkipUnless(t2.finalSequence.count >= 3 * B)
+                var diverged = t2.finalSequence
+                diverged[2 * B] = (diverged[2 * B] + 1) % 900
+                assertTurn("\(quant) diverged", prompt: diverged + continuation(2), params: p, K: K,
+                           session: session, expectedReused: 2 * B)
+            }
+        }
+    }
+
+    /// Same, for the pre-allocated pool storage form.
+    func testPooledKVSessionExactness() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        var p = c.params.toGenerationParams()
+        p.kvPoolEnabled = true
+        p.kvPoolCapacity = 32   // force at least one geometric growth across turns
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("pool turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+        let t2 = assertTurn("pool turn2", prompt: t1.finalSequence + continuation(5), params: p, K: 4,
+                            session: session, expectedReused: t1.finalSequence.count)
+        var diverged = t2.finalSequence
+        diverged[B + 1] = (diverged[B + 1] + 1) % 900
+        assertTurn("pool diverged", prompt: diverged + continuation(2), params: p, K: 4,
+                   session: session, expectedReused: B)
+    }
+
+    // MARK: - Storage-level truncation (every LayerKVCache form, incl. per-channel kivi4)
+
+    /// `CompressedKVTensor.truncated(toTokens:)` must equal compressing the leading tokens alone —
+    /// bitwise on packed words, scales and biases — for the per-token layout and for the
+    /// per-channel (kivi4, group = 32 tokens) layout the toy fixtures (B = 16) never reach.
+    func testCompressedTruncationMatchesFreshCompression() throws {
+        MLXRandom.seed(5)
+        // Real-model KV shape (nKV 4, head_dim 128), 3 blocks of 32 tokens.
+        let x = MLXRandom.normal([1, 4, 96, 128]).asType(.float16)
+        for (bits, gs, perChannel) in [(4, 64, false), (8, 64, false), (4, 32, true)] {
+            let full = CompressedKVTensor.compress(x, bits: bits, groupSize: gs, perChannel: perChannel)
+            XCTAssertEqual(full.perChannel, perChannel)
+            for n in [32, 64] {
+                let cut = full.truncated(toTokens: n)
+                let fresh = CompressedKVTensor.compress(x[0..., 0..., 0 ..< n, 0...], bits: bits, groupSize: gs, perChannel: perChannel)
+                XCTAssertEqual(cut.originalShape, [1, 4, n, 128])
+                XCTAssertEqual(cut.packed.shape, fresh.packed.shape, "bits \(bits) gs \(gs) pc \(perChannel) n \(n)")
+                XCTAssertTrue(same(cut.packed, fresh.packed), "packed differ (\(bits)/\(gs)/\(perChannel), n=\(n))")
+                XCTAssertTrue(same(cut.scales, fresh.scales), "scales differ")
+                if let cb = cut.biases, let fb = fresh.biases {
+                    XCTAssertTrue(same(cb, fb), "biases differ")
+                }
+                // Re-appending the dropped block restores the full representation.
+                let regrown = cut.append(x[0..., 0..., n ..< (n + 32), 0...])
+                XCTAssertTrue(same(regrown.packed, full.truncated(toTokens: n + 32).packed),
+                              "append after truncate must match (\(bits)/\(gs)/\(perChannel), n=\(n))")
+            }
+        }
+        // Per-channel cut off a group boundary is refused loudly (precondition) — not testable
+        // in-process; documented in Plans/exp5b-notes-impl-?.md instead.
+    }
+
+    /// `LayerKVCache.truncateCommitted(to:)` for raw, pool and compressed storage: after cutting
+    /// back and re-committing the same block, the stored K/V equal the never-truncated store.
+    func testLayerKVCacheTruncateAllStorageForms() throws {
+        MLXRandom.seed(11)
+        // Real-model per-layer block shape [1, nKV, B, head_dim] in f16 (group-64 modes need ≥ 64 wide).
+        let blocks = (0 ..< 3).map { _ in
+            (MLXRandom.normal([1, 4, 32, 128]).asType(.float16), MLXRandom.normal([1, 4, 32, 128]).asType(.float16))
+        }
+        let forms: [(String, () -> LayerKVCache)] = [
+            ("raw", { LayerKVCache() }),
+            ("pool", { LayerKVCache(usePool: true, initialPoolCapacity: 32) }),
+            ("k8v4", { LayerKVCache(quantization: .k8v4) }),
+            ("kivi4", { LayerKVCache(quantization: .kivi4) }),
+        ]
+        for (name, make) in forms {
+            let ref = make()
+            let cut = make()
+            for (k, v) in blocks {
+                for c in [ref, cut] {
+                    c.pendingKeys = k; c.pendingValues = v
+                    c.commitPending(usePool: name == "pool", quantization: c.quantizationMode)
+                }
+            }
+            XCTAssertEqual(cut.committedLength, 96, name)
+            cut.truncateCommitted(to: 32)
+            XCTAssertEqual(cut.committedLength, 32, name)
+            XCTAssertNil(cut.pendingKeys, name)
+            XCTAssertTrue(same(cut.keys!, ref.keys![0..., 0..., 0 ..< 32, 0...]), "\(name): truncated keys")
+            XCTAssertTrue(same(cut.values!, ref.values![0..., 0..., 0 ..< 32, 0...]), "\(name): truncated values")
+            for (k, v) in blocks[1...] {
+                cut.pendingKeys = k; cut.pendingValues = v
+                cut.commitPending(usePool: name == "pool", quantization: cut.quantizationMode)
+            }
+            XCTAssertEqual(cut.committedLength, 96, name)
+            XCTAssertTrue(same(cut.keys!, ref.keys!), "\(name): regrown keys")
+            XCTAssertTrue(same(cut.values!, ref.values!), "\(name): regrown values")
+            XCTAssertEqual(cut.logicalBytes, ref.logicalBytes, "\(name): byte accounting")
+            // Cut to zero empties the store.
+            cut.truncateCommitted(to: 0)
+            XCTAssertEqual(cut.committedLength, 0, name)
+            XCTAssertNil(cut.keys, name)
+        }
+    }
+
+    // MARK: - Reset and bound
+
+    func testResetDropsEverything() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let t1 = assertTurn("turn1", prompt: c.prompt, params: p, K: 4, session: session, expectedReused: 0)
+        XCTAssertGreaterThan(session.cachedTokenCount, 0)
+        XCTAssertGreaterThan(session.cachedBytes, 0)
+        session.reset()
+        XCTAssertEqual(session.cachedTokenCount, 0)
+        XCTAssertEqual(session.cachedBytes, 0)
+        XCTAssertNil(session.key)
+        assertTurn("after-reset", prompt: t1.finalSequence + continuation(3), params: p, K: 4,
+                   session: session, expectedReused: 0)
+    }
+
+    /// A call whose committed length exceeds `maxCachedTokens` leaves the session empty (all or
+    /// nothing — absolute positions make partial eviction impossible), counted as an eviction.
+    func testMaxCachedTokensBound() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache(maxCachedTokens: 2 * B)
+        let engine = DiffusionEngine(model: model, speculationK: 4)
+        let out = engine.generateCached(prompt: c.prompt, params: p, session: session)
+        XCTAssertGreaterThan(out.finalSequence.count, 2 * B)
+        XCTAssertEqual(session.cachedTokenCount, 0)
+        XCTAssertEqual(session.boundEvictions, 1)
+        let out2 = engine.generateCached(prompt: out.finalSequence + continuation(2), params: p, session: session)
+        XCTAssertEqual(out2.metrics.sessionReusedTokens, 0)
+    }
+
+    /// Sanity: the session path adds no blocking readbacks to the loop (the sync audit).
+    func testSessionAddsNoSyncPoints() throws {
+        let c = try fixtureCase("p16_q_noeos")
+        let p = c.params.toGenerationParams()
+        let session = SessionPrefixCache()
+        let engine = DiffusionEngine(model: model, speculationK: 4)
+        let t1 = engine.generateCached(prompt: c.prompt, params: p, session: session)
+        let prompt2 = t1.finalSequence + continuation(3)
+        let fresh = engine.generateCached(prompt: prompt2, params: p)
+        let reused = engine.generateCached(prompt: prompt2, params: p, session: session)
+        XCTAssertEqual(reused.syncPoints, fresh.syncPoints)
+    }
+}
