--- /dev/null
+++ b/Packages/DiffusionGeneration/Sources/SessionPrefixCache.swift
@@ -0,0 +1,169 @@
+import Foundation
+import MLX
+import DiffusionCore
+
+/// Cross-turn **session** prefix cache (exp-5b): carries the committed-block K/V of one
+/// `generateCached` call into the next, so a multi-turn chat whose turn-`N+1` prompt begins with
+/// turn `N`'s prompt + answer skips the prefill forwards for those blocks.
+///
+/// **Exactness argument** `[inferred from phase-2 §5 deviation 1 + LLaDA2Attention cached path]`:
+/// under the `.strict` block mask a committed block's K/V depend only on (model weights, the
+/// tokens of that block and of every earlier block, the block's absolute positions, the KV
+/// storage mode). `generateCached` commits every block through either the dedicated capture
+/// forward or the clean-commit skip (proven output-identical, `testSkipRedundantCommitForwardParity`)
+/// — the very computation the next call's prefill would run over the same tokens. So reusing a
+/// block whose tokens (and all preceding tokens) are unchanged is *identical*, not approximate:
+/// `finalSequence` with a session equals `finalSequence` without one.
+///
+/// **What is reused**: only whole `blockLength` blocks; only the longest leading run whose tokens
+/// equal the session's committed tokens; never beyond the new prompt's full blocks
+/// (`prompt.count / B` — the prompt tail shares a block with generation and is never prefilled).
+///
+/// **Compatibility** (``Key``): block length, KV quantization mode, pool flag and the model
+/// instance must match, or the session is **reset** and started afresh by the new call. Features
+/// that change *what* a commit holds — sub-block commit (partial blocks), MultiBD (`nBuf != 1`),
+/// FlashBlock / dual caching (per-layer attention state living on `LayerKVCache`), ICE templates,
+/// module ablation, Elastic-Cache — make a call **bypass** the session entirely (neither read nor
+/// written; see `GenerationParams.sessionReuseEligible`).
+///
+/// **Cost** `[inferred from KVCacheQuantization doc + LLaDA2.1-mini config]`: a session holds the
+/// committed K/V for every committed token — per token `layers × nKV × headDim × 2 (K,V) × bytes`:
+/// 20 × 4 × 128 × 2 × 2 B = **40,960 B/token** FP16 (`.none`), 16,640 B/token `k8v4`,
+/// 12,160 B/token `kivi4` (+ pool slack up to 2× when `kvPoolEnabled`). `maxCachedTokens`
+/// bounds it: a call whose committed length exceeds the bound leaves the session **empty**
+/// (positions are absolute, so a leading prefix cannot be evicted — it is all or nothing).
+/// Default 8192 tokens ≈ 335 MB FP16.
+///
+/// **Sync-freedom**: the reuse decision compares Swift `[Int]` token arrays and truncation is lazy
+/// slicing — zero GPU→CPU readbacks are added, per step or per call.
+///
+/// **Not thread-safe**: one session per serialised request stream (the single-request server).
+public final class SessionPrefixCache {
+
+    /// Everything that changes the bytes a committed block stores. Two calls may share a session
+    /// only if their keys are equal.
+    public struct Key: Equatable, Sendable {
+        public let blockLength: Int
+        public let kvQuantization: KVCacheQuantization
+        public let kvPoolEnabled: Bool
+        public let modelID: ObjectIdentifier
+
+        public init(blockLength: Int, kvQuantization: KVCacheQuantization,
+                    kvPoolEnabled: Bool, modelID: ObjectIdentifier) {
+            self.blockLength = blockLength
+            self.kvQuantization = kvQuantization
+            self.kvPoolEnabled = kvPoolEnabled
+            self.modelID = modelID
+        }
+    }
+
+    /// Upper bound on the committed tokens a session will hold after a call (see the type doc).
+    public let maxCachedTokens: Int
+
+    /// Tokens whose K/V are currently held (always a multiple of the key's block length).
+    public private(set) var committedTokens: [Int] = []
+    /// Tokens whose K/V are currently held.
+    public var cachedTokenCount: Int { committedTokens.count }
+    /// Configuration the held K/V were produced under; `nil` when empty.
+    public private(set) var key: Key?
+    /// Logical bytes of the held K/V across layers (0 when empty).
+    public var cachedBytes: Int { layers?.reduce(0) { $0 + $1.logicalBytes } ?? 0 }
+
+    // Diagnostics (effective echoes of what happened, not of what was requested).
+    /// Prompt tokens whose prefill the most recent call skipped.
+    public private(set) var lastReusedTokens: Int = 0
+    /// Times a call found the session's key incompatible and started it afresh.
+    public private(set) var incompatibleResets: Int = 0
+    /// Times a call's committed length exceeded `maxCachedTokens` and the session was emptied.
+    public private(set) var boundEvictions: Int = 0
+
+    private var layers: [LayerKVCache]?
+
+    public init(maxCachedTokens: Int = 8192) {
+        precondition(maxCachedTokens > 0)
+        self.maxCachedTokens = maxCachedTokens
+    }
+
+    /// Drop everything (K/V, tokens, key). Diagnostics counters are kept.
+    public func reset() {
+        layers = nil
+        committedTokens = []
+        key = nil
+    }
+
+    // MARK: - Engine-facing (internal)
+
+    /// Build the ``ExactPrefixCache`` for a call: adopt the session's layers truncated to the
+    /// reusable leading blocks, or a fresh cache when nothing is reusable. Returns the number of
+    /// prompt tokens whose prefill the caller must skip (`reusedBlocks * B`, already committed).
+    ///
+    /// While the call runs the session holds no layers (they belong to the live cache); `store`
+    /// hands them back at the end. A call that never reaches `store` leaves the session empty.
+    func prepare(
+        prompt: [Int], key callKey: Key, layerCount: Int,
+        initialPoolCapacity: Int
+    ) -> (cache: ExactPrefixCache, reusedTokens: Int) {
+        let B = callKey.blockLength
+        if let existing = key, existing != callKey {
+            if !committedTokens.isEmpty || layers != nil { incompatibleResets += 1 }
+            reset()
+        }
+        key = callKey
+
+        let prefillBlocks = prompt.count / B
+        var lcp = 0
+        let n = min(committedTokens.count, prompt.count)
+        while lcp < n && committedTokens[lcp] == prompt[lcp] { lcp += 1 }
+        let reusedBlocks = min(lcp / B, prefillBlocks, committedTokens.count / B)
+        let reusedTokens = reusedBlocks * B
+        lastReusedTokens = reusedTokens
+
+        if reusedTokens > 0, let held = layers, held.count == layerCount,
+           held.allSatisfy({ $0.committedLength == committedTokens.count }) {
+            for layer in held {
+                layer.resetTransientState()
+                layer.truncateCommitted(to: reusedTokens)
+            }
+            committedTokens = Array(committedTokens[0 ..< reusedTokens])
+            layers = nil
+            let cache = ExactPrefixCache(
+                adopting: held, usePool: callKey.kvPoolEnabled, quantization: callKey.kvQuantization)
+            return (cache, reusedTokens)
+        }
+
+        // Nothing reusable (or an inconsistent hold — never trust it): start clean.
+        lastReusedTokens = 0
+        layers = nil
+        committedTokens = []
+        let cache = ExactPrefixCache(
+            layerCount: layerCount, usePool: callKey.kvPoolEnabled,
+            initialPoolCapacity: initialPoolCapacity, quantization: callKey.kvQuantization)
+        return (cache, 0)
+    }
+
+    /// Hand the finished call's cache back to the session. `committed` is the call's
+    /// `finalSequence` (every committed block, prompt + generated). Defensive: a cache whose
+    /// committed length disagrees with the token list, a non-block-aligned length, or a length
+    /// over the bound empties the session instead of storing something unprovable.
+    func store(cache: ExactPrefixCache, committed: [Int]) {
+        guard let key else { return }
+        let B = key.blockLength
+        let consistent = committed.count % B == 0
+            && cache.layers.allSatisfy { $0.committedLength == committed.count }
+        guard consistent else {
+            assertionFailure("SessionPrefixCache.store: cache/token inconsistency (\(committed.count) tokens, "
+                + "layer lengths \(cache.layers.map(\.committedLength)))")
+            reset()
+            return
+        }
+        if committed.count > maxCachedTokens {
+            boundEvictions += 1
+            layers = nil
+            committedTokens = []
+            return
+        }
+        for layer in cache.layers { layer.resetTransientState() }
+        layers = cache.layers
+        committedTokens = committed
+    }
+}
